            "type": [
              "string",
              "null"
            ],
            "description": "单位类型名称"
          },
          "regionCode": {
            "type": [
              "string",
              "null"
            ],
            "description": "标准省级地区编码"
          },
          "publishedAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 时间，可能为空",
            "format": "date-time"
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 时间，可能为空",
            "format": "date-time"
          },
          "contentFetchedAt": {
            "type": [
              "string",
              "null"
            ],
