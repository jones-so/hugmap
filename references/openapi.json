{
  "openapi": "3.1.0",
  "info": {
    "title": "巨图引擎招投标 API",
    "version": "1.0.0",
    "description": "Skill 与 API 共用接口和 X-API-Key。免 Key 按公网 IP、带 Key 按账号，各自每天 100 次，北京时间零点重置。网站会话不占用外部额度。成功业务请求扣次，失败不扣。个人关注必须带 Key。"
  },
  "servers": [
    {
      "url": "https://www.hugmap.com"
    }
  ],
  "paths": {
    "/api/v1/opportunities": {
      "get": {
        "operationId": "get_opportunities",
        "summary": "检索公告",
        "description": "沿用网站统一字典和筛选逻辑。仅返回已授权且可公开的真实公告，列表不包含正文；正文和附件通过详情接口读取。每页是一次业务调用。",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "description": "关键词，搜索项目、采购人及需求",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "region",
            "in": "query",
            "description": "省级地区编码或兼容中文名称；从字典 region 获取",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "采购品类编码；父品类包含全部下级，支持多品类公告匹配",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "stage",
            "in": "query",
            "description": "招标阶段字典编码",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "procurementMethod",
            "in": "query",
            "description": "采购方式字典编码，独立于招标阶段",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "noticeType",
            "in": "query",
            "description": "兼容旧参数：阶段名称或采购方式；不建议与 stage 冲突使用",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tenderType",
            "in": "query",
            "description": "招标类型字典编码",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "buyerType",
            "in": "query",
            "description": "实际采购人单位类型字典编码",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "publishedRange",
            "in": "query",
            "description": "发布时间快捷选项，取自 publishedRange 字典；日期按北京时间计算",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "publishedFrom",
            "in": "query",
            "description": "起始发布日期，包含当天；YYYY-MM-DD",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "publishedTo",
            "in": "query",
            "description": "结束发布日期，包含当天；YYYY-MM-DD",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "deadlineRange",
            "in": "query",
            "description": "投标截止快捷选项，取自 deadlineRange 字典",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "deadlineFrom",
            "in": "query",
            "description": "截止日期下界，包含当天；YYYY-MM-DD",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "deadlineTo",
            "in": "query",
            "description": "截止日期上界，包含当天；YYYY-MM-DD",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "deadlineMissing",
            "in": "query",
            "description": "是否仅查询未公布截止日期的公告",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "budgetRange",
            "in": "query",
            "description": "预算快捷选项，取自 budgetRange 字典",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "budgetMin",
            "in": "query",
            "description": "预算下界（人民币元），包含边界",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "budgetMax",
            "in": "query",
            "description": "预算上界（人民币元），不包含边界",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "上一页返回的 nextCursor；后续请求保持相同筛选和 limit，不自行构造",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页条数，默认 25，最多 100",
            "schema": {
              "type": "integer",
              "default": 25,
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "headers": {
              "X-RateLimit-Limit": {
                "description": "当日免费总额度",
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Remaining": {
                "description": "包含正在执行请求预占额度后的剩余次数",
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Reset": {
                "description": "下一次北京时间零点的 Unix 秒时间戳",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResult"
                }
              }
            }
          },
          "400": {
            "description": "筛选、日期或游标无效，不扣次数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Key 无效、已撤销，或个人关注未提供 Key，不扣次数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "项目或附件不存在，不扣次数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "当日额度用尽；匿名请传 Key，账号请等待北京时间零点重置；不自动重试",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "附件下载地址或源站暂不可用，不扣次数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "服务暂不可用，不扣次数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/opportunities/{id}": {
      "get": {
        "operationId": "get_opportunities_id",
        "summary": "读取完整详情",
        "description": "免费额度内无需登录或 Key，返回已同步的完整正文、官方来源和附件。历史别名会解析到规范公告。源站无正文或仍在同步会通过 contentStatus 说明，不承诺不存在的正文。",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "项目 ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "headers": {
              "X-RateLimit-Limit": {
                "description": "当日免费总额度",
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Remaining": {
                "description": "包含正在执行请求预占额度后的剩余次数",
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Reset": {
                "description": "下一次北京时间零点的 Unix 秒时间戳",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Opportunity"
                }
              }
            }
          },
          "400": {
            "description": "筛选、日期或游标无效，不扣次数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Key 无效、已撤销，或个人关注未提供 Key，不扣次数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "项目或附件不存在，不扣次数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "当日额度用尽；匿名请传 Key，账号请等待北京时间零点重置；不自动重试",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "附件下载地址或源站暂不可用，不扣次数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "服务暂不可用，不扣次数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/opportunities/{id}/attachments/{attachmentId}/download": {
      "get": {
        "operationId": "get_opportunities_id_attachments_attachmentId_download",
        "summary": "下载附件或获取下载地址",
        "description": "直接下载推荐 redirect=true。OSS 签名链接短期有效，不持久缓存。源站要求验证时返回官方入口，需要用户完成源站验证；不绕过访问控制。跨域重定向不得携带 Key。",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "项目 ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "attachmentId",
            "in": "path",
            "required": true,
            "description": "附件 ID，取自详情 attachments",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "redirect",
            "in": "query",
            "description": "true：返回 302 或文件流；false：返回 JSON 下载地址。签发地址扣一次，后续访问该地址不重复扣次；proxy 模式返回五分钟有效的一次性站内交付地址，原样访问即可，不需要再传 Key。",
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "headers": {
              "X-RateLimit-Limit": {
                "description": "当日免费总额度",
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Remaining": {
                "description": "包含正在执行请求预占额度后的剩余次数",
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Reset": {
                "description": "下一次北京时间零点的 Unix 秒时间戳",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "downloadUrl": {
                      "type": "string"
                    },
                    "requiresVerification": {
                      "type": "boolean"
                    },
                    "downloadMethod": {
                      "type": "string",
                      "enum": [
                        "official",
                        "proxy"
                      ]
                    }
                  }
                }
              },
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "302": {
            "description": "跳转至 OSS 临时签名地址或官方附件地址，本请求扣 1 次",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "X-RateLimit-Limit": {
                "description": "当日免费总额度",
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Remaining": {
                "description": "包含正在执行请求预占额度后的剩余次数",
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Reset": {
                "description": "下一次北京时间零点的 Unix 秒时间戳",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "400": {
            "description": "筛选、日期或游标无效，不扣次数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Key 无效、已撤销，或个人关注未提供 Key，不扣次数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "项目或附件不存在，不扣次数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "当日额度用尽；匿名请传 Key，账号请等待北京时间零点重置；不自动重试",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "附件下载地址或源站暂不可用，不扣次数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "服务暂不可用，不扣次数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
