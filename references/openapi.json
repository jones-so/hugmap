    "schemas": {
      "Opportunity": {
        "type": "object",
        "required": [
          "id",
          "title",
          "attachments"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "规范公告 ID"
          },
          "title": {
            "type": "string",
            "description": "公告标题"
          },
          "buyer": {
            "type": "string",
            "description": "实际采购人"
          },
          "region": {
            "type": "string",
            "description": "地区名称"
          },
          "category": {
            "type": "string",
            "description": "主品类名称"
          },
          "noticeType": {
            "type": "string",
            "description": "招标阶段名称"
          },
          "summary": {
            "type": [
              "string",
              "null"
            ],
            "description": "项目摘要"
          },
          "requirements": {
            "type": [
              "string",
              "null"
            ],
            "description": "采购需求"
          },
          "sourceName": {
            "type": [
              "string",
              "null"
            ],
            "description": "官方来源名称"
          },
          "sourceUrl": {
            "type": [
              "string",
              "null"
            ],
            "description": "官方公告地址"
          },
          "sourceContentHtml": {
            "type": [
              "string",
              "null"
            ],
            "description": "已清理的官方 HTML 正文；为空时可读取 sourceContentText"
          },
          "sourceContentText": {
            "type": [
              "string",
              "null"
            ],
            "description": "正文纯文本"
          },
          "contentStatus": {
            "type": [
              "string",
              "null"
            ],
            "description": "正文同步状态，如已同步、源站无正文或待同步；以实际返回为准"
          },
          "stageCode": {
            "type": [
              "string",
              "null"
            ],
            "description": "标准阶段编码"
          },
          "procurementMethodCode": {
            "type": [
              "string",
              "null"
            ],
            "description": "标准采购方式编码"
          },
          "procurementMethod": {
            "type": [
              "string",
              "null"
            ],
            "description": "采购方式名称"
