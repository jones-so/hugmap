    "/api/v1/usage": {
      "get": {
        "operationId": "get_usage",
        "summary": "查询当前身份额度",
        "description": "不扣调用次数。无 Key 返回当前公网 IP 额度，有 Key 返回所属账号额度；无效 Key 返回 401。",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {}
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功",
            "headers": {
              "X-RateLimit-Limit": {
                "description": "当日免费总额度",
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Remaining": {
