    "/api/v1/attachment-deliveries/{ticket}": {
      "get": {
        "operationId": "consume_attachment_delivery",
        "summary": "使用一次性附件交付凭据",
        "description": "仅用于 download?redirect=false 返回的 proxy 地址。获取该地址时已扣次，此请求不再扣次；凭据五分钟过期且只能使用一次。不要自行构造。",
        "security": [],
        "parameters": [
          {
            "name": "ticket",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "下载接口返回地址中的一次性凭据"
          }
        ],
        "responses": {
          "200": {
            "description": "附件文件流",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "302": {
            "description": "官方或 OSS 下载跳转"
          },
          "410": {
            "description": "凭据过期或已使用"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
