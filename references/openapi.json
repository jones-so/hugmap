            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Dictionaries": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer"
          },
          "catalogSource": {
            "type": "string"
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DictionaryEntry"
            }
          }
        }
      },
      "DictionaryEntry": {
        "type": "object",
        "properties": {
          "dimension": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          },
          "sort": {
            "type": "integer"
          },
          "enabled": {
            "type": "boolean"
          },
          "mergedInto": {
            "type": [
              "string",
              "null"
            ]
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "values": {
            "type": "object",
