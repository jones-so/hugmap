            "type": "integer"
          },
          "sources": {
            "type": "integer"
          },
          "sampleData": {
            "type": "boolean"
          },
          "coverage": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "collectionMode": {
            "type": "string"
          },
          "categoryCounts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
